@startuml
!pragma layout smetana
title Plataforma EJA — casos de uso principais
left to right direction
skinparam shadowing false

actor Visitante
actor "Estudante da EJA" as Estudante
actor Licenciando
actor Administrador

rectangle "Plataforma EJA" {
  usecase "Consultar cursos externos" as Cursos
  usecase "Consultar e filtrar vagas" as Vagas
  usecase "Cadastrar-se e entrar" as Cadastro
  usecase "Consultar perfis de licenciandos" as Perfis
  usecase "Solicitar apoio" as Solicitar
  usecase "Cancelar solicitação pendente" as Cancelar
  usecase "Consultar suas solicitações" as Solicitações
  usecase "Consultar contatos após aceite" as Contatos
  usecase "Atualizar disciplinas\ne disponibilidade" as Perfil
  usecase "Aceitar ou recusar solicitação" as Responder
  usecase "Cadastrar, atualizar\ne encerrar vagas" as GerirVagas
}

Visitante -- Cursos
Visitante -- Vagas
Visitante -- Cadastro
Estudante -- Perfis
Estudante -- Solicitar
Estudante -- Cancelar
Estudante -- Solicitações
Estudante -- Contatos
Licenciando -- Perfil
Licenciando -- Responder
Licenciando -- Solicitações
Licenciando -- Contatos
Administrador -- GerirVagas

@enduml
