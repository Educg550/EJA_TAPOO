@startuml
!pragma layout elk
title Plataforma EJA — classes principais
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class Usuario {
  -id: int
  -nomeExibicao: str
  -email: str
  -senhaHash: str
  -tipo: TipoUsuario
}

class PerfilLicenciando {
  -disciplinas: set[str]
  -disponibilidade: str
}

class SolicitacaoApoio {
  -id: int
  -estado: EstadoSolicitacao
  -criadaEm: datetime
  +aceitar(atorId)
  +recusar(atorId)
  +cancelar(atorId)
}

together {
  class CursoExterno {
    -idEVG: int
    -titulo: str
    -cargaHorariaHoras: int
    -prazoRealizacaoDias: int
    -urlOficial: str
  }

  class OportunidadeTrabalho {
    -id: int
    -titulo: str
    -empresa: str
    -cidade: str
    -uf: str
    -areaTrabalho: str
    -escolaridadeMinima: Escolaridade [0..1]
    -urlCandidatura: str [0..1]
    -contatoCandidatura: str [0..1]
    -inscricoesAte: date [0..1]
    -ativa: bool
  }
}

Usuario "1" *-- "0..1" PerfilLicenciando : possui
SolicitacaoApoio "0..*" --> "1" Usuario : solicitante (estudante)
SolicitacaoApoio "0..*" --> "1" PerfilLicenciando : destinatário

@enduml
