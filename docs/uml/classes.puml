@startuml
!pragma layout elk
title Plataforma EJA — classes principais
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class Usuario {
  -id: int
  -nomeExibicao: str
  -email: str
  -senhaHash: str
  +{abstract} permissoes()
}

class EstudanteEJA {
  +permissoes()
}

class Licenciando {
  -disciplinas: set[str]
  -disponibilidade: str
  +permissoes()
}

class Administrador {
  +permissoes()
}

class SolicitacaoApoio {
  -id: int
  -estado: EstadoSolicitacao
  -criadaEm: datetime
  +aceitar(atorId)
  +recusar(atorId)
  +cancelar(atorId)
}

together {
  class CursoExterno {
    -id: int
    -titulo: str
    -cargaHorariaHoras: int
    -prazoRealizacaoDias: int
    -urlOficial: str
  }

  class OportunidadeTrabalho {
    -id: int
    -titulo: str
    -empresa: str
    -cidade: str
    -uf: str
    -areaTrabalho: str
    -escolaridadeMinima: Escolaridade [0..1]
    -urlCandidatura: str [0..1]
    -contatoCandidatura: str [0..1]
    -inscricoesAte: date [0..1]
    -ativa: bool
  }
}

Usuario <|-- EstudanteEJA
Usuario <|-- Licenciando
Usuario <|-- Administrador
EstudanteEJA "1" <-- "0..*" SolicitacaoApoio : solicitante
Licenciando "1" <-- "0..*" SolicitacaoApoio : destinatário

@enduml
